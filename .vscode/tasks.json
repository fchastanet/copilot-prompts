{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AI Linter: Validate Skills",
      "type": "shell",
      "command": "ai-linter",
      "args": ["--skills", ".", "--log-format", "logfmt"],
      "group": "test",
      "problemMatcher": {
        "owner": "ai-linter",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^level=\"(WARNING|ERROR)\"\\s+rule=\"([^\"]+)\"\\s+path=\"([^\"]+)\"(?:\\s+line=\"(\\d+)\")?\\s+message=\"([^\"]+)\"",
          "file": 3,
          "line": 4,
          "severity": 1,
          "message": 5
        }
      }
    },
  ]
}
