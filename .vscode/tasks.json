{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lint Skills, Agents & prompts",
      "type": "shell",
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "command": "ai-linter",
      "args": [".", "--skills"],
      "presentation": {
        "revealProblems": "onProblem",
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "owner": "ai-linter",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^level=\"(WARNING|ERROR)\"\\s+rule=\"([^\"]+)\"\\s+path=\"([^\"]+)\"(?:\\s+line=\"(\\d+)\")?\\s+message=\"([^\"]+)\"",
          "file": 3,
          "line": 4,
          "severity": 1,
          "message": 5
        }
      }
    }
  ]
}
